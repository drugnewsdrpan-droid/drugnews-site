<!doctype html><html lang="{{LANG}}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{TITLE}}｜Drugnews</title>{{ROBOTS}}<style>
*{box-sizing:border-box}body{margin:0;color:#20333b;background:#f3f6f6;font-family:"PingFang TC","Noto Sans TC",sans-serif;line-height:1.85}.sheet{max-width:920px;margin:32px auto;padding:48px;background:white}.report-header{border-bottom:3px solid #246b70;padding-bottom:24px}.report-header small{color:#246b70;font-weight:700}h1{font-size:38px;line-height:1.35;margin:12px 0}h2{font-size:25px;line-height:1.45;margin:32px 0 16px}h3{font-size:20px}p,li{overflow-wrap:anywhere}.meta{color:#586b73;font-size:14px}.preview{padding:14px;background:#fff3d9;border:1px solid #e9ce91;font-weight:700}.summary{padding:24px;background:#edf5f5;margin-top:24px}.figure{break-inside:avoid;margin:28px 0}.figure img{max-width:100%;height:auto}.figure-space{border:2px dashed #a9babc;min-height:180px;display:grid;place-items:center;color:#5c757b}.caption{font-size:14px;color:#4e666f;margin:8px 0}.sources{font-size:14px;border-top:1px solid #d4dee0;padding-top:16px}a{color:#246b70}footer{font-size:12px;color:#5c6d73;border-top:1px solid #d4dee0;padding-top:16px;margin-top:32px}
@media(max-width:600px){.sheet{margin:0;padding:24px 20px}h1{font-size:28px}h2{font-size:23px}}
@page{size:A4;margin:18mm 17mm}@media print{body{background:white;font-size:10.5pt}.sheet{max-width:none;margin:0;padding:0}h1{font-size:26pt}h2{font-size:17pt;break-after:avoid}.report-section{break-before:page}.summary,h1,footer{break-inside:avoid}.preview{font-size:9pt}.figure-space{height:58mm;min-height:58mm}a{color:inherit;text-decoration:none}}
</style></head><body><main class="sheet">{{PREVIEW_BANNER}}<header class="report-header"><small>{{BRAND_LABEL}}</small><h1>{{TITLE}}</h1><p>{{COVERAGE}}</p><p>{{SUBTITLE}}</p><p class="meta">{{META}}</p>{{LANGUAGE_LINK}}</header><section class="summary"><h2>{{SUMMARY_LABEL}}</h2>{{SUMMARY}}</section>{{CONTENTS}}{{SECTIONS}}<section class="sources"><h2>{{SOURCES_LABEL}}</h2>{{REFERENCES}}</section>{{DOWNLOAD}}<footer>{{FOOTER}}</footer></main></body></html>
