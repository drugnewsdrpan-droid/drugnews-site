{
  "name": "drugnews-release-watchdog",
  "main": "entry.mjs",
  "compatibility_date": "2026-09-22",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "WATCHDOG_ENABLED": "false" },
  "durable_objects": { "bindings": [{ "name": "COORDINATOR", "class_name": "ReleaseCoordinator" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReleaseCoordinator"] }],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
