{
  "name": "drugnews-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "publish": "node scripts/publish_articles.mjs && node scripts/build_english_site.mjs && node scripts/build_japanese_site.mjs && node scripts/build_topic_hubs.mjs && node scripts/build_company_index.mjs && node scripts/inject_analytics.mjs",
    "publish:force": "node scripts/publish_articles.mjs --force && node scripts/build_english_site.mjs && node scripts/build_japanese_site.mjs && node scripts/build_topic_hubs.mjs && node scripts/build_company_index.mjs && node scripts/inject_analytics.mjs",
    "build:topics": "node scripts/build_topic_hubs.mjs",
    "build:en": "node scripts/build_english_site.mjs",
    "build:ja": "node scripts/build_japanese_site.mjs",
    "build:companies": "node scripts/build_company_index.mjs",
    "analytics": "node scripts/inject_analytics.mjs",
    "tracking:configure": "node scripts/configure_site_tracking.mjs",
    "daily:social": "node scripts/daily_social_update_check.mjs",
    "daily:social:dry": "node scripts/daily_social_update_check.mjs --dry-run",
    "daily:social:capture": "node scripts/daily_social_update_check.mjs --capture-facebook --capture-dcard",
    "codex:daily": "scripts/codex_daily_start.sh",
    "daily:fb": "node scripts/daily_facebook_update_check.mjs",
    "daily:fb:dry": "node scripts/daily_facebook_update_check.mjs --dry-run",
    "audit:references": "node scripts/audit_references.mjs",
    "audit:references:strict": "node scripts/audit_references.mjs --strict",
    "audit:reader": "node scripts/audit_reader_experience.mjs",
    "audit:reader:strict": "node scripts/audit_reader_experience.mjs --strict",
    "audit:reading-product": "node scripts/audit_reading_product_tasks.mjs",
    "audit:reading-product:strict": "node scripts/audit_reading_product_tasks.mjs --strict",
    "audit:english-localization": "node scripts/audit_english_localization.mjs",
    "audit:pm": "node scripts/audit_daily_pm_health.mjs",
    "audit:pm:strict": "node scripts/audit_daily_pm_health.mjs --strict",
    "checkpoint:cxo": "node scripts/summarize_daily_status.mjs",
    "growth:brief": "node scripts/generate_daily_growth_brief.mjs",
    "repair:summaries": "node scripts/repair_truncated_summaries.mjs",
    "chrome:social": "scripts/start_social_capture_chrome.sh",
    "capture:fb": "node scripts/scrape_facebook_cdp.mjs profile https://www.facebook.com/profile.php?id=61568446257142 /private/tmp/drugnews-facebook-latest.json",
    "capture:dcard": "node scripts/scrape_dcard_cdp.mjs profile https://www.dcard.tw/f/persona_drugnews /private/tmp/drugnews-dcard-latest.json",
    "translate:en": "node scripts/translate_articles_to_english.mjs",
    "translate:en:all": "node scripts/translate_articles_to_english.mjs --all",
    "figure:protect:en:valuation": "node scripts/render_protect_en_figure_02.mjs",
    "figure:en:localized": "node scripts/generate_english_localized_assets.mjs"
  }
